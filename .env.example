# llm-bridge configuration
# Copy this file to .env and fill in your values.

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# ── Claude.ai ────────────────────────────────────────────────────────────────
CLAUDE_ENABLED=false
# Option A: paste cookies exported from your browser as a JSON array
# CLAUDE_COOKIES=[{"name":"sessionKey","value":"...","domain":"claude.ai","path":"/"}]
# Option B: path to a Playwright storage state file (includes cookies + localStorage)
# CLAUDE_STORAGE_STATE=sessions/claude.json

# ── ChatGPT ──────────────────────────────────────────────────────────────────
CHATGPT_ENABLED=false
# CHATGPT_COOKIES=[{"name":"__Secure-next-auth.session-token","value":"...","domain":"chatgpt.com","path":"/"}]
# CHATGPT_STORAGE_STATE=sessions/chatgpt.json

# ── Gemini ───────────────────────────────────────────────────────────────────
GEMINI_ENABLED=false
# GEMINI_COOKIES=[{"name":"SID","value":"...","domain":".google.com","path":"/"}]
# GEMINI_STORAGE_STATE=sessions/gemini.json

# ── Grok (xAI) ───────────────────────────────────────────────────────────────
GROK_ENABLED=false
# GROK_COOKIES=[{"name":"auth_token","value":"...","domain":"grok.com","path":"/"}]
# GROK_STORAGE_STATE=sessions/grok.json

# ── Perplexity ───────────────────────────────────────────────────────────────
PERPLEXITY_ENABLED=false
# PERPLEXITY_COOKIES=[{"name":"__Secure-next-auth.session-token","value":"...","domain":"www.perplexity.ai","path":"/"}]
# PERPLEXITY_STORAGE_STATE=sessions/perplexity.json

# ── Microsoft Copilot ────────────────────────────────────────────────────────
COPILOT_ENABLED=false
# COPILOT_COOKIES=[{"name":"MUID","value":"...","domain":"copilot.microsoft.com","path":"/"}]
# COPILOT_STORAGE_STATE=sessions/copilot.json
